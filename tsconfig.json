{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "middleware/**/*.ts",
    "proxy.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "prisma.config.ts",
    "next.config.ts",
    "instrumentation.ts",
    "vitest.config.ts",
    "vitest.frozen.config.ts",
    "playwright.config.ts",
    "generated/prisma/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "yetkin.ai",
    ".next",
    "dist",
    "coverage",
    "archived",
    "tests/**/*surface.test.ts",
    "tests/studio/**",
    "tests/devlabs/**",
    "tests/kurumsal/**",
    "tests/hibe/**",
    "tests/arena/**",
    "tests/pazaryeri/**",
    "tests/junior/**",
    "tests/social/**",
    "tests/kernel/four-room-smoke.test.ts",
    "tests/kernel/earnings-bridge.test.ts",
    "tests/helpers/memory-arena.ts",
    "tests/helpers/memory-devlabs.ts",
    "tests/helpers/memory-hibe.ts",
    "tests/helpers/memory-junior.ts",
    "tests/helpers/memory-kurumsal.ts",
    "tests/helpers/memory-pazaryeri.ts",
    "tests/helpers/memory-social.ts",
    "tests/helpers/memory-studio.ts",
    "tests/helpers/pazaryeri-cash-journey.ts",
    "tests/helpers/studio-cash-journey.ts",
    "tests/helpers/earnings-bridge.ts",
    "tests/helpers/junior-bond.ts",
    "tests/helpers/three-ring-journey.ts",
    "tests/e2e/studio-happy-path.spec.ts",
    "tests/e2e/yetkinilan-happy-path.spec.ts",
    "scripts/ops-storage-cors-check.ts"
  ]
}
