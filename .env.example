# yetkin.ai env şablonu — .system_docs/OPS_RUNBOOK.md
# cp .env.example .env.local  sonra Dashboard değerleriyle doldur.
# Credential icat edilmez. Boş anahtar = dürüst kapalı yüzey.
# Müze (yetkin.ai) .env kopyalanmaz: Redis, GİB, Socket, Turnstile, ads, OAuth şişmesi,
# LOCAL_MOCK_AUTH, MAINTENANCE_MODE, SUPABASE_SERVICE_ROLE_KEY Rail kodunda yoktur.

# --- Postgres (S13-A: yeni Supabase; müze projesi yasak) ---
# Uygulama (Vercel runtime): DATABASE_URL = Transaction pooler :6543
#   postgresql://postgres.<ref>:<şifre>@aws-0-<bölge>.pooler.supabase.com:6543/postgres?sslmode=require&connection_limit=10&pool_timeout=10
# Kullanıcı postgres.<project-ref> (düz postgres = tenant not found).
# Session pooler (aynı host :5432) IPv4 için yedek; Vercel'de :6543 tercih.
# Lokal Windows: DATABASE_URL = Direct `db.<ref>.supabase.co` IPv6 (AAAA) tuzağıdır;
# runtime her zaman pooler :6543. DIRECT_URL yalnız ops:migrate.
# Prisma `pgbouncer=true` / `connection_limit` / `pool_timeout` pg'ye gitmez —
# kod soyar; adapter Pool.max=10 ve connectionTimeoutMillis=10000 uygular.
# ops:migrate: DIRECT_URL = db.<ref>.supabase.co:5432 (havuz YASAK).
# Host pooler.supabase.com ve port 6543 migrasyonda YASAK.
# Kapalı lab (hosted Auth değildir; Direct Port :5432, db=yetkin_rail_lab):
#   docker compose -f docker-compose.postgres.yml up -d
#   npm run verify:pg-lab
# RAIL_PG_INTEGRATION env siciline yazılmaz; verify:pg-lab loopback URL basar.
DATABASE_URL=""
DIRECT_URL=""
# Prisma migrate diff (isteğe bağlı).
SHADOW_DATABASE_URL=""
# İsteğe bağlı yerel / yüksek gecikmeli ortam performans ayarları (boş = varsayılan):
DASHBOARD_PULSE_ROOM_TIMEOUT_MS=""
DASHBOARD_PULSE_LOAD_BUDGET_MS=""
DASHBOARD_PULSE_ROOM_CONCURRENCY=""
PRISMA_POOL_MAX=""
PRISMA_POOL_TIMEOUT_MS=""
KERNEL_BACKGROUND_READ_TIMEOUT_MS=""
DB_READ_TIMEOUT_MS=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Canlı yayın dondurma. "true" veya "1" = ürün 503; /legal, /iletisim, robots, sitemap ve health geçer.
# PayTR denetimi ve canlı yayın: BOŞ bırakın. Acil bakım için true.
# Müze MAINTENANCE_MODE değildir. NODE_ENV=development ve localhost yok sayılır.
SITE_MAINTENANCE_FREEZE=""
# Bakım bypass — sır boşsa header/cookie ile geçiş YOKTUR (fail-closed).
# SUPER_ADMIN_USER_ID bypass sırrı değildir; yalnız bu iki anahtar.
SITE_MAINTENANCE_BYPASS_TOKEN=""
MAINTENANCE_BYPASS_SECRET=""
NEXT_PUBLIC_SETTLEMENT_CURRENCY="TRY"
# Playwright. Doluysa mevcut sunucuya vurur (ikinci next dev açılmaz).
# Boş bırakılırsa spec 127.0.0.1:3000 sürecini kendisi yönetir.
E2E_BASE_URL=""
# T3/T4 canlı halka — mevcut vizeli vatandaş + müşteri. Yeni gmail icat etme (Auth kotası).
E2E_T3_EMAIL=""
E2E_T3_PASSWORD=""
# T3 amiral SKU: boş = 01_office_ai. İkinci geçiş ops: T3_COURSE_SLUG=02_ecommerce_ai
E2E_T4_WORKER_EMAIL=""
E2E_T4_WORKER_PASSWORD=""
E2E_T4_CLIENT_EMAIL=""
E2E_T4_CLIENT_PASSWORD=""
# Staging T4 saha runner (npm run verify:staging-t4-loop). Boşsa NEXT_PUBLIC_APP_URL.
# Closed Testing: RAIL_DRON_ORIGINS boş kalır. PAYTR_SANDBOX=1 (test-net). Mock yok.
STAGING_APP_URL=""

# --- Supabase Auth (S13-A). Form her zaman açık; boşsa gönderim dürüst hata basar. ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Auth → Providers → Email: Confirm email üretimde AÇIK olmalı.
# Kapalıysa GoTrue signUp oturum basar. Rail kayıt artık Set-Cookie yazmaz ve
# "onay bekleniyor" basar; fakat /login şifre ile girer. Çöp hesap kapısı
# Confirm email + Dashboard Auth SMTP'dir (NOTICE_SMTP bildirim kanalıdır, Auth değil).
# Inbucket / yerel mock bu repoda yoktur; localhost hosted Auth + isteğe bağlı
# geliştirme yedeği (SMTP 500, NODE_ENV≠production) kullanır — panele düşmez.
# Kenar HS256 yedek (Dashboard → API → JWT Secret). ES256 asıl yol JWKS:
# {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Boşsa ES256 JWKS ile doğrulanır; HS256 token fail-closed düşer.
SUPABASE_JWT_SECRET=""

# --- PayTR (mağaza no / key / salt). Üçlü birlikte dolu olmalı. ---
# Lab yolları (CREDIT yalnız HMAC Bildirim URL veya valör PSP doğrulaması ile doğar):
#   A) Mock: PAYTR_ALLOW_MOCK_CHECKOUT=true ve üçlü BOŞ — iFrame token basar, bakiyeye DÜŞMEZ,
#      PENDING aynı istekte FAILED kapanır (takılmaz). Harç/akademi bu yolla alınmaz.
#   B) Sandbox: üçlü = PayTR test mağaza + PAYTR_SANDBOX=1. get-token test_mode=1.
#      localhost Bildirim URL alamaz; HTTPS tünel veya Inngest valör (durum API) gerekir.
#   C) Canlı: üçlü = panel canlı değerler. PAYTR_SANDBOX ve mock BOŞ. Üretimde doluysa throw.
# Mağaza onayı sonrası drop-in (kod yok; Vercel Production secret store):
#   1) PAYTR_MERCHANT_ID / _KEY / _SALT = panel CANLI üçlü (test mağaza yazılmaz)
#   2) PAYTR_SANDBOX ve PAYTR_ALLOW_MOCK_CHECKOUT = boş veya anahtar silinmiş
#   3) Panel Bildirim URL = https://yetkin.ai/api/paytr/callback
#      (aynı handler: /api/payments/webhooks/paytr)
#   4) PAYTR_WEBHOOK_IP_ALLOWLIST = isteğe bağlı PayTR Destek IP/CIDR (virgül).
#      Boş = yalnız HMAC. Örnek: 185.187.184.84,212.252.97.250,213.74.97.150
# Bu şablonun PAYTR_SANDBOX="1" satırı lab reçetesidir; üretime kopyalanmaz.
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_SANDBOX="1"
# Yalnızca "true" yerel mock checkout açar (`lib/kernel/payments/paytr/mock-checkout.ts`).
# Production'da true ise checkout throw eder. CREDIT yazmaz. Boş bırakın.
PAYTR_ALLOW_MOCK_CHECKOUT=""
# PayTR Destek bildirim IP/CIDR listesi (virgül). Boş = yalnız HMAC (lab ve üretim).
# Cloudflare kenarı XFF'yi PayTR kaynağı gibi göstermez; boş liste 403 basmaz.
# Kod, env doluyken resmi host'ları birleştirir: 185.187.184.84, 212.252.97.250, 213.74.97.150.
# Bu üç IP'den gelen Bildirim URL testi HMAC olmasa da düz metin HTTP 200 OK döner (CREDIT yok).
# Daraltmak için örn. 185.187.184.84,212.252.97.250,213.74.97.150 — CREDIT kapısı yine HMAC'dir.
PAYTR_WEBHOOK_IP_ALLOWLIST=""

# --- LLM gümrük kapısı — en az bir sağlayıcı. Doğrudan client yasak. ---
# .env.local'de tırnaksız yazın (GEMINI_API_KEY=AIza... veya AQ....).
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Platform AI günlük tavanı (TRY minor). Boşsa kod varsayılanı 500000.
AI_PLATFORM_DAILY_CAP_MINOR="500000"

# --- Inngest Cloud (S18-A) — PayTR valör + emanet TTL. ---
# Çift anahtar dolduğu anda serve açılır: /api/jobs/inngest (auth = "webhook").
# Cloud: Event Key + Signing Key (App id: yetkin-rail). İkisi de boşsa üretim 503.
# Yerel duman (Cloud yokken): INNGEST_DEV=1 yalnızca .env.local'e yazılır.
# Şablona INNGEST_DEV ataması yok; üretim kilidini açmaz. npx inngest-cli dev.
# Üretim 503 çıkışı: npm run ops:runtime-readiness
# GET /api/health 200 ≠ Inngest hazır; checks.inngest=configured şart.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Vatandaş e-posta asgarisi (T-02). Resend / Postmark SDK yok. ---
# "E-posta API Key" = SMTP kimliği: NOTICE_SMTP_USER + NOTICE_SMTP_PASS.
# Gün 0: NOTICE_SMTP_HOST + NOTICE_MAIL_FROM dolu olmalı (akademi satın alma makbuzu / bildirim).
# Nakit bloğu değildir; boşsa dürüst atlanır (SMTP skipped). Canlıda warn log.
# NOTICE_MAIL_FROM = SMTP zarf gönderen. Vitrin destek kutusu kodda LEGAL_SUPPORT_EMAIL
# (destek@yetkin.ai); gönderen kutu ile karıştırılmaz.
# Boş = dürüst atlanır; nakit / emanet durmaz. Kısmi (yalnız host) = skip.
# Port boşsa 587 + STARTTLS; 465 örtük TLS. Beş olay: teklif, kabul, teslim, RELEASE, TTL.
NOTICE_SMTP_HOST=""
NOTICE_SMTP_PORT=""
NOTICE_SMTP_USER=""
NOTICE_SMTP_PASS=""
NOTICE_MAIL_FROM=""

# --- Hazine sentinel (SQL ile aynı). Super Admin olarak YAZILMAZ. ---
PLATFORM_TREASURY_USER_ID="00000000-0000-4000-8000-000000000001"

# --- DevLabs HMAC biberi — ARŞİV / 410 (GEÇERSİZ). Canlı bağlama / üretim bloğu değildir. ---
# Boş bırak. Kod varsayılanını env'e yapıştırma. ops:runtime-readiness çıkış 1 nedeni saymaz.
DEVLABS_KEY_PEPPER=""

# --- Super Admin (`isSuperAdminUser` / `isCanonicalSuperAdminEmail`). Boşsa kimse admin değildir. ---
# Auth kullanıcı UUID'si (Authentication → Users). Hazine sentinel'i yazılmaz.
SUPER_ADMIN_USER_ID=""
# Super Admin e-posta (küçük harf). Boşsa e-posta ile kimse admin değildir. Git'e adres yazılmaz.
CANONICAL_SUPER_ADMIN_EMAIL=""

# --- Akademi sınav oturumu MAC (Sitting Seal). Üretimde ≥16 karakter zorunlu. ---
# Dedicated secret yoksa SUPABASE_JWT_SECRET ≥16 üzerinden domain-ayrılmış derive (sınav 503 değildir).
# Lab / Vitest: ikisi de boşsa kod yedek sırrı. Canlı süreçte ikisi de yoksa mühür 503.
ACADEMY_EXAM_SITTING_SECRET=""

# --- yetkin.ai İş dron CORS (yalnız /api/v1). Virgüllü origin allowlist. Boş = CORS başlığı yok (saf native). Joker * yasak. İstemci: .system_docs/DRON_CLIENT_SPEC.md ---
RAIL_DRON_ORIGINS=""
# Native dron (apps/rail-is) env şablonu: apps/rail-is/.env.example
# EXPO_PUBLIC_RAIL_API_BASE + EXPO_PUBLIC_SUPABASE_URL + EXPO_PUBLIC_SUPABASE_ANON_KEY
# service_role yazılmaz. Amiral .env.local native pakete kopyalanmaz.

# Kenar hız tavanı ve PayTR user_ip. Platform X-Forwarded-For'a sağdan hop ekler.
# 0 = XFF yok sayılır (spoof kova açamaz). 1 = tek kenar (yalnız Vercel).
# Cloudflare → Vercel canlı reçete = 2. Kod boş varsayılanı 1 (spoof güvenli).
# İlk XFF değeri kullanılmaz. x-real-ip yedek değildir.
TRUSTED_PROXY_HOPS="2"

# --- Ops omurgası (canlı bağlama; A7) ---
# Çalışan 4 oda + 4 sığınak. 410 envanteri archived/ + kenar 410. Bu fazda nesne depo YOK.
# 1) DATABASE_URL (Vercel: pooler :6543) + DIRECT_URL (migrate: db.<ref>.supabase.co:5432)
# 2) NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY
# 3) npm run ops:migrate        # prisma migrate deploy + kilitli SQL (studio-assets.sql YOK; bucket/CORS YOK)
#    Lab (hosted Auth yok): docker compose -f docker-compose.postgres.yml up -d && npm run verify:pg-lab
#    Hosted DIRECT_URL lab betiğinde kullanılmaz.
#    Hosted apply: npm run ops:hosted-apply-preflight  sonra npm run ops:migrate
#    Lab dump/restore: npm run ops:pg-backup-restore
#    Operatör iptal (HTTP yok): npm run ops:revoke-academy-certificate -- --hash <64hex> --reason "..."
#    Mutabakat sapması (HTTP yok): npm run ops:list-payment-anomalies
# 4) /register ile ilk kullanıcı → UUID'yi SUPER_ADMIN_USER_ID yap → npm run dev yeniden
# PayTR webhook: /api/paytr/callback (panel) = /api/payments/webhooks/paytr (auth = "webhook")
# Inngest / PayTR üretim sicili: npm run ops:runtime-readiness
# SMTP/JWT boş nakit durmaz. DEVLABS_KEY_PEPPER / Studio bucket canlı reçete değildir (ARŞİV / 410).
# Bildirim asgarisi: NOTICE_SMTP_* boşsa e-posta atlanır; Resend yok.
# Faz 1 lab: mock bakiyeye düşmez. Sandbox/canlı üçlü + Bildirim URL veya Inngest valör.
