# yetkin-rail env şablonu — docs/07_OPS_RUNBOOK.md
# cp .env.example .env.local  sonra Dashboard değerleriyle doldur.
# Credential icat edilmez. Boş anahtar = dürüst kapalı yüzey.
# Müze (yetkin.ai) .env kopyalanmaz: Redis, GİB, Socket, Turnstile, ads, OAuth şişmesi,
# LOCAL_MOCK_AUTH, MAINTENANCE_MODE, SUPABASE_SERVICE_ROLE_KEY Rail kodunda yoktur.

# --- Postgres (S13-A: yeni Supabase; müze projesi yasak) ---
# Uygulama: DATABASE_URL session-mode (port 5432 veya session pooler).
# Transaction-mode pooler (:6543) FOR UPDATE / $transaction kilidini düşürür — YASAK.
# Host pooler.supabase.com migrasyon ve runtime'da YASAK.
# ops:migrate: DIRECT_URL = db.<ref>.supabase.co:5432
# Host pooler.supabase.com ve port 6543 migrasyonda YASAK.
DATABASE_URL=""
DIRECT_URL=""
# Prisma migrate diff (isteğe bağlı).
SHADOW_DATABASE_URL=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
NEXT_PUBLIC_SETTLEMENT_CURRENCY="TRY"
# Playwright. Doluysa mevcut sunucuya vurur (ikinci next dev açılmaz).
# Boş bırakılırsa spec 127.0.0.1:3000 sürecini kendisi yönetir.
E2E_BASE_URL=""

# --- Supabase Auth (S13-A). Boşsa giriş/kayıt formu dürüst kapalı kalır. ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Kenar HS256 yedek (Dashboard → API → JWT Secret). ES256 asıl yol JWKS:
# {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Boşsa ES256 JWKS ile doğrulanır; HS256 token fail-closed düşer.
SUPABASE_JWT_SECRET=""

# --- PayTR. Üretimde SANDBOX ve mock yasak. ---
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_SANDBOX="1"
# Yalnızca "true" yerel mock checkout açar (`lib/kernel/payments/paytr/checkout.ts`).
# Production'da true ise checkout throw eder. Boş bırakın.
PAYTR_ALLOW_MOCK_CHECKOUT=""

# --- LLM gümrük kapısı — en az bir sağlayıcı. Doğrudan client yasak. ---
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Platform AI günlük tavanı (TRY minor). Boşsa kod varsayılanı 500000.
AI_PLATFORM_DAILY_CAP_MINOR="500000"

# --- Inngest Cloud (S18-A) — PayTR valör + emanet TTL + Arena tur. ---
# Webhook yolu: /api/jobs/inngest (export const auth = "webhook")
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Hazine sentinel (SQL ile aynı). Super Admin olarak YAZILMAZ. ---
PLATFORM_TREASURY_USER_ID="00000000-0000-4000-8000-000000000001"

# --- DevLabs anahtar kasası HMAC biberi (S33-A). Boşsa kod varsayılanı; üretimde zorunlu. ---
DEVLABS_KEY_PEPPER=""

# --- Super Admin (`isSuperAdminUser`). Boşsa kimse admin değildir. ---
# Auth kullanıcı UUID'si (Authentication → Users). Hazine sentinel'i yazılmaz.
SUPER_ADMIN_USER_ID=""

# --- Ops omurgası ---
# 1) DATABASE_URL + DIRECT_URL  (DIRECT = db.<ref>.supabase.co:5432, havuz değil)
# 2) NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY
# 3) npm run ops:migrate        # prisma migrate deploy + yedi SQL (studio-assets.sql YOK)
# 4) Dashboard SQL Editor: supabase/storage/studio-assets.sql
# 5) Storage CORS: Allowed Origins = NEXT_PUBLIC_APP_URL origin; Methods = PUT (* yasak)
#    npm run ops:storage-cors
# 6) /register ile ilk kullanıcı → UUID'yi SUPER_ADMIN_USER_ID yap → npm run dev yeniden
# PayTR webhook: /api/payments/webhooks/paytr (auth = "webhook")
