// Kernel şema — çekirdek kimlik, nakit, emanet, fiyat, AI defteri.
// Modül tabloları kendi prisma/schema/<modül>.prisma dosyasında açılır.
// Kernel runtime dikey motor import etmez; User satırı dikey FK'leri taşır.
// amountMinor + currencyCode. amountKurus kolon adı yasak.

enum EscrowHoldStatus {
  PENDING
  RELEASED
  REFUNDED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  CLEARED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum PriceCatalogUnitType {
  MINOR
  BPS
}

enum BillingInvoiceType {
  INDIVIDUAL
  CORPORATE
}

/// Kimlik SSOT uygulama yüzeyi. Auth UUID Supabase'ten gelir; Prisma id üretmez.
/// Kolon şişmesi yok; dikey ters ilişkiler Prisma zorunluluğudur.
model User {
  id          String   @id
  email       String   @unique
  displayName String?  @map("display_name")
  locale      String   @default("tr-TR")
  timeZone    String   @default("Europe/Istanbul") @map("time_zone")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  wallets             Wallet[]
  ledgerEntries       LedgerEntry[]
  escrowHolds         EscrowHold[]
  paymentOrders       PaymentOrder[]
  checkoutPriceLocks  CheckoutPriceLock[]
  aiTokenUsages       AiTokenUsage[]
  freelancerJobs       FreelancerJob[]       @relation("FreelancerJobClient")
  freelancerJobInvites FreelancerJob[]       @relation("FreelancerJobInvitee")
  freelancerBids       FreelancerBid[]       @relation("FreelancerBidBidder")
  freelancerAsClient   FreelancerContract[]  @relation("FreelancerContractClient")
  freelancerAsWorker   FreelancerContract[]  @relation("FreelancerContractFreelancer")
  freelancerDisputesInitiated FreelancerDispute[] @relation("FreelancerDisputeInitiator")
  freelancerDisputesAsClient  FreelancerDispute[] @relation("FreelancerDisputeClient")
  freelancerDisputesAsWorker  FreelancerDispute[] @relation("FreelancerDisputeFreelancer")
  freelancerMessagesSent      FreelancerContractMessage[] @relation("FreelancerContractMessageSender")
  freelancerMessagesAsClient  FreelancerContractMessage[] @relation("FreelancerContractMessageClient")
  freelancerMessagesAsWorker  FreelancerContractMessage[] @relation("FreelancerContractMessageFreelancer")
  freelancerSquadsLead        FreelancerSquad[] @relation("FreelancerSquadLead")
  freelancerSquadsAsClient    FreelancerSquad[] @relation("FreelancerSquadClient")
  freelancerSquadMemberships  FreelancerSquadMember[] @relation("FreelancerSquadMember")
  academyPurchases     AcademyPurchase[]
  academyCertificates  AcademyCertificate[]
  academyExamAttempts  AcademyExamAttempt[]
  academyExamSittings  AcademyExamSitting[]
  academyLessonCompletions AcademyLessonCompletion[]
  careerPortfolioItems CareerPortfolioItem[]
  careerVisaStamps     CareerVisaStamp[]
  httpIdempotencyRecords   HttpIdempotencyRecord[]
  paidCommandReservations  PaidCommandReservation[]
  userBillingInfo          UserBillingInfo?

  @@map("users")
}

/// Kullanıcı fatura künyesi — Bireysel / Kurumsal. User satırı şişmez. Cep PayTR user_phone.
model UserBillingInfo {
  id           String             @id @default(cuid())
  userId       String             @unique @map("user_id")
  invoiceType  BillingInvoiceType @map("invoice_type")
  fullName     String?            @map("full_name")
  tckn         String?            @db.VarChar(11)
  companyTitle String?            @map("company_title")
  taxOffice    String?            @map("tax_office")
  vkn          String?            @db.VarChar(10)
  phone        String             @db.VarChar(16)
  address      String             @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_billing_info")
}

/// Tek nakit SSOT. Bir kullanıcı × bir para birimi = bir satır.
/// amount_minor >= 0 DB CHECK. Bakiye yalnız defter CTE'si ile değişir.
model Wallet {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  currencyCode String   @db.Char(3) @map("currency_code")
  amountMinor  Int      @default(0) @map("amount_minor")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  escrowHolds   EscrowHold[]

  @@unique([userId, currencyCode])
  @@unique([id, userId, currencyCode])
  @@index([userId])
  @@map("wallets")
}

/// Append-only defter. UPDATE/DELETE trigger yasak. Tutar pozitif minor. CASCADE yok.
model LedgerEntry {
  id             String          @id @default(cuid())
  walletId       String          @map("wallet_id")
  userId         String          @map("user_id")
  amountMinor    Int             @map("amount_minor")
  currencyCode   String          @db.Char(3) @map("currency_code")
  direction      LedgerDirection
  label          String
  purpose        String
  idempotencyKey String          @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId, userId, currencyCode], references: [id, userId, currencyCode], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@map("ledger_entries")
}

/// Emanet kilidi — bakiye türü değil. gross = hold + net.
/// PSP hold cüzdan satırına çivi çakmaz; kimlik referenceKey + isteğe bağlı pspPaymentId.
/// Wallet yalnız Merchant akademi bakiyesidir. DB CHECK: 20260819040000_escrow_hold_checks.
model EscrowHold {
  id            String           @id @default(cuid())
  walletId      String?          @map("wallet_id")
  pspPaymentId  String?          @map("psp_payment_id")
  userId        String           @map("user_id")
  referenceKey  String           @unique @map("reference_key")
  status        EscrowHoldStatus @default(PENDING)
  currencyCode  String           @db.Char(3) @map("currency_code")
  grossMinor    Int              @map("gross_minor")
  holdMinor     Int              @map("hold_minor")
  netMinor      Int              @map("net_minor")
  holdBps       Int              @map("hold_bps")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  releasedAt    DateTime?        @map("released_at")
  refundedAt    DateTime?        @map("refunded_at")
  expiresAt     DateTime?        @map("expires_at")

  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([userId, status])
  @@index([pspPaymentId])
  @@map("escrow_holds")
}

/// PSP siparişi. merchantOid idempotency evrenidir.
model PaymentOrder {
  id             String             @id @default(cuid())
  userId         String             @map("user_id")
  provider       String
  merchantOid    String             @unique @map("merchant_oid")
  purpose        String
  amountMinor    Int                @map("amount_minor")
  currencyCode   String             @db.Char(3) @map("currency_code")
  status         PaymentOrderStatus @default(PENDING)
  clearingStatus String?            @map("clearing_status")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  paidAt         DateTime?          @map("paid_at")
  clearedAt      DateTime?          @map("cleared_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("payment_orders")
}

/// Append-only nakit anomali / mutabakat kaydı. İkinci bakiye değildir; CREDIT yazmaz.
/// user_id yok: sipariş bulunamayabilir. FORCE RLS + politika yok = PostgREST sıfır satır.
model PaymentAnomaly {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  kind           String
  merchantOid    String   @map("merchant_oid")
  expectedMinor  Int?     @map("expected_minor")
  reportedMinor  Int?     @map("reported_minor")
  orderId        String?  @map("order_id")
  walletId       String?  @map("wallet_id")
  requestId      String   @map("request_id")
  sourceIp       String?  @map("source_ip")
  detail         String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([merchantOid, createdAt])
  @@map("payment_anomalies")
}

/// Super Admin fiyat kataloğu — kod sabiti satış fiyatı yok.
model PriceCatalogEntry {
  id           String               @id @default(cuid())
  moduleKey    String               @map("module_key")
  unitKey      String               @map("unit_key")
  unitType     PriceCatalogUnitType @default(MINOR) @map("unit_type")
  amountMinor  Int                  @map("amount_minor")
  currencyCode String               @db.Char(3) @map("currency_code")
  isActive     Boolean              @default(true) @map("is_active")
  minMinor     Int?                 @map("min_minor")
  maxMinor     Int?                 @map("max_minor")
  description  String?
  updatedBy    String?              @map("updated_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([moduleKey, unitKey])
  @@index([moduleKey])
  @@map("price_catalog_entries")
}

/// Append-only gerekçeli zam defteri. Sessiz zam yok. updatedAt yok; ikinci fiyat SSOT değildir.
model PriceCatalogDecisionLedger {
  id              String               @id @default(cuid())
  catalogEntryId  String               @map("catalog_entry_id")
  moduleKey       String               @map("module_key")
  unitKey         String               @map("unit_key")
  unitType        PriceCatalogUnitType @map("unit_type")
  reasonCode      String               @map("reason_code")
  reason          String               @db.Text
  oldMinor        Int                  @map("old_minor")
  newMinor        Int                  @map("new_minor")
  currencyCode    String               @db.Char(3) @map("currency_code")
  actorUserId     String               @map("actor_user_id")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([catalogEntryId, createdAt])
  @@index([moduleKey, unitKey, createdAt])
  @@map("price_catalog_decision_ledger")
}

/// 15 dakika checkout kilidi. Süresi bitmiş kilitle debit yok.
model CheckoutPriceLock {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  lockKey         String    @map("lock_key")
  moduleKey       String    @map("module_key")
  unitKey         String    @map("unit_key")
  amountMinor     Int       @map("amount_minor")
  currencyCode    String    @db.Char(3) @map("currency_code")
  catalogMinor    Int       @map("catalog_minor")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lockKey])
  @@index([userId, expiresAt])
  @@map("checkout_price_locks")
}

/// LLM kullanım defteri — gümrük kapısı yazar. costMinor aynı nakit birim.
model AiTokenUsage {
  id               String   @id @default(cuid())
  userId           String?  @map("user_id")
  source           String
  provider         String
  model            String
  roleKey          String?  @map("role_key")
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  costMinor        Int      @map("cost_minor")
  currencyCode     String   @db.Char(3) @map("currency_code")
  idempotencyKey   String?  @unique @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([source, createdAt])
  @@map("ai_token_usages")
}

/// HTTP Idempotency-Key replay — çift tıklama ikinci finansal emir doğurmaz.
model HttpIdempotencyRecord {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  route        String
  key          String
  requestHash  String   @map("request_hash")
  status       String
  statusCode   Int      @map("status_code")
  responseJson String   @map("response_json") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, key])
  @@index([userId])
  @@map("http_idempotency_records")
}

enum PaidCommandStatus {
  RESERVED
  PROVIDER_DONE
  SETTLED
  FAILED
}

/// Ücretli dış yan etki rezervi — HTTP Idempotency-Key ile bağlanır. İkinci bakiye değildir.
model PaidCommandReservation {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  scope          String
  commandKey     String            @map("command_key")
  requestHash    String            @map("request_hash")
  status         PaidCommandStatus
  estimatedMinor Int               @map("estimated_minor")
  currencyCode   String            @db.Char(3) @map("currency_code")
  providerJson   String?           @map("provider_json") @db.Text
  resultId       String?           @map("result_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  settledAt      DateTime?         @map("settled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, commandKey])
  @@index([userId, createdAt])
  @@map("paid_command_reservations")
}
