// Akademi dikey dilimi — Faz 3A anında settlement + Faz 9 sınav kapısı (S58-A) + D2.1 oynatıcı.
// Kurs fiyatı PriceCatalogEntry verisidir; course satırında tutar yok (S11-A).
// Satın al = öğrenme kaydı. Ders içeriği SETTLED olmadan açılmaz. Ustalık belgesi ≥70 sınav mührüdür.
// User şişmez: purchase + certificate + exam attempt + lesson completion ters ilişkileri.

enum AcademyPurchaseStatus {
  SETTLED
}

enum AcademyExamAttemptStatus {
  GRADED
}

model AcademyCourse {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String
  catalogUnitKey String   @unique @map("catalog_unit_key")
  /// Dünya sırası — düşük = daha trend.
  globalRank     Int      @default(99) @map("global_rank")
  /// Türkiye sırası — düşük = daha trend.
  localRank      Int      @default(99) @map("local_rank")
  /// Vitrin endeksi: globalRank × localRank (düşük önce).
  trendScore     Float    @default(0) @map("trend_score")
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  purchases    AcademyPurchase[]
  certificates AcademyCertificate[]
  exam         AcademyExam?
  examSittings AcademyExamSitting[]
  lessonCompletions AcademyLessonCompletion[]

  @@index([isPublished, trendScore])
  @@index([isPublished, createdAt])
  @@map("academy_courses")
}

/// Instant settlement kaydı. priceLockId çekirdek CheckoutPriceLock'a string FK.
model AcademyPurchase {
  id           String                @id @default(cuid())
  userId       String                @map("user_id")
  courseId     String                @map("course_id")
  priceLockId  String                @map("price_lock_id")
  amountMinor  Int                   @map("amount_minor")
  currencyCode String                @db.Char(3) @map("currency_code")
  status       AcademyPurchaseStatus @default(SETTLED)
  settledAt    DateTime              @map("settled_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       AcademyCourse        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  certificate  AcademyCertificate?
  examAttempts AcademyExamAttempt[]
  lessonCompletions AcademyLessonCompletion[]

  @@unique([userId, courseId])
  @@index([userId, createdAt])
  @@index([courseId])
  @@map("academy_purchases")
}

/// Müfredat sınavı — kursa 1:1. questionsJson mühürlü havuzdur (30–50 soru).
/// Oturum havuzdan rastgele 10 soru çeker, şıkları karıştırır; doğru şıklar sunucuda kalır.
model AcademyExam {
  id            String   @id @default(cuid())
  courseId      String   @unique @map("course_id")
  title         String
  passScore     Int      @default(70) @map("pass_score")
  questionsJson String   @map("questions_json") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course   AcademyCourse        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  attempts AcademyExamAttempt[]
  sittings AcademyExamSitting[]

  @@map("academy_exams")
}

model AcademyExamAttempt {
  id          String                    @id @default(cuid())
  examId      String                    @map("exam_id")
  userId      String                    @map("user_id")
  purchaseId  String                    @map("purchase_id")
  answersJson String                    @map("answers_json") @db.Text
  score       Int
  passed      Boolean
  status      AcademyExamAttemptStatus  @default(GRADED)
  submittedAt DateTime                  @map("submitted_at")
  createdAt   DateTime                  @default(now()) @map("created_at")

  exam        AcademyExam         @relation(fields: [examId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase    AcademyPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  certificate AcademyCertificate?

  @@index([userId, examId])
  @@index([purchaseId, submittedAt])
  @@map("academy_exam_attempts")
}

/// Sınav oturumu mühürü — HMAC jetonunun sunucu sicili. JTI tek sefer tüketilir.
model AcademyExamSitting {
  jti            String    @id
  userId         String     @map("user_id")
  courseId       String     @map("course_id")
  examId         String     @map("exam_id")
  itemsJson      String     @map("items_json") @db.Text
  proofLessonKey String?   @map("proof_lesson_key")
  startedAt      DateTime  @map("started_at")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  exam   AcademyExam   @relation(fields: [examId], references: [id], onDelete: Restrict)

  @@index([userId, examId])
  @@index([expiresAt])
  @@map("academy_exam_sittings")
}

model AcademyCertificate {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  courseId         String   @map("course_id")
  purchaseId       String   @unique @map("purchase_id")
  attemptId        String?  @unique @map("attempt_id")
  title            String
  serialKey        String   @unique @map("serial_key")
  certificateHash  String?  @unique @map("certificate_hash")
  curriculumSeal   String?  @map("curriculum_seal")
  score            Int?
  issuedAt         DateTime @map("issued_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?  @map("revoke_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   AcademyCourse        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase AcademyPurchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  attempt  AcademyExamAttempt?  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([userId, issuedAt])
  @@map("academy_certificates")
}

/// SETTLED satın alma sonrası ders tamamlama. İçerik kod tohumudur (CMS yok).
model AcademyLessonCompletion {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  courseId    String   @map("course_id")
  purchaseId  String   @map("purchase_id")
  lessonKey   String   @map("lesson_key")
  proofOfWorkHash String?  @map("proof_of_work_hash") @db.Char(64)
  completedAt DateTime @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   AcademyCourse   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase AcademyPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, lessonKey])
  @@index([userId, courseId])
  @@map("academy_lesson_completions")
}

/// Ders TTS kalıcı önbellek. Byte kamu WAV veya `lesson-audios`; satır locator + mediaReleaseSeal.
/// Gemini yalnız bake miss'te çağrılır. PostgREST yazma yok; Prisma yazar.
model AcademyAudioCache {
  id               String   @id @default(cuid())
  cacheKey         String   @unique @map("cache_key")
  courseSlug       String   @map("course_slug")
  lessonKey        String   @map("lesson_key")
  bucket           String
  objectPath       String   @unique @map("object_path")
  publicUrl        String   @map("public_url")
  mimeType         String   @map("mime_type")
  byteSize         Int      @map("byte_size")
  model            String
  mediaReleaseSeal String?  @map("media_release_seal")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([courseSlug, lessonKey])
  @@map("academy_audio_cache")
}
