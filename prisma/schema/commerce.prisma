/// Yetkin Commerce — mağaza, Master SKU, append-only stok defteri, pazaryeri kasası.
/// Sahiplik kolonu `owner_user_id` kasıtlıdır: canlı RLS sahiplik sicilinde yoktur.
/// PostgREST `rls_deny_unscoped` (SELECT USING false) alır. Yazma politikası üretilmez.
/// Fiyat `amount_minor`. Para birimi mağazada yalnız TRY.
/// Uzak stok `on_hand_qty` üzerine yazılmaz. Kargo etiketi bu şemada yoktur.
/// Aylık lisans `commerce_subscriptions` satırıdır. Pazaryeri satışı bu tabloya ciro yazmaz.

enum CommerceStoreStatus {
  DRAFT
  ACTIVE
}

enum CommerceProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CommerceVariantStatus {
  DRAFT
  ACTIVE
  PASSIVE
}

enum CommerceCatalogSource {
  MANUAL
  MANUAL_CSV
  TEZGAH_PAZARYERI
}

enum InventoryDirection {
  IN
  OUT
}

enum InventoryTransactionType {
  INBOUND
  SALE
  ADJUSTMENT
  RETURN
}

enum CommerceChannel {
  TRENDYOL
  HEPSIBURADA
}

enum CommerceSubscriptionStatus {
  PENDING
  ACTIVE
}

enum CommerceListingSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CommerceWebhookReceiptStatus {
  APPLIED
  STOCK_SHORT
}

/// Kokpit stok defteri. Taslak onaylanmadan `approved_stock_qty` değişmez.
enum StockLedgerType {
  INBOUND_DRAFT
  INBOUND_APPROVED
  CHANNEL_SALE
  RETURN_RESTOCK
}

enum SalesChannelKind {
  OWN_STORE
  TRENDYOL
  HEPSIBURADA
  AMAZON
  N11
}

enum SalesChannelStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum CommerceInboxKind {
  ORDER
  QUESTION
  EXPERT_TASK
  STOCK_ALERT
  CUSTOMER_QUESTION
  PRODUCT_REVIEW
}

/// Gelen kutu yanıtı. `ANSWERED` yalnız kanalın kabul ettiği gönderimdir.
enum CommerceInboxMessageStatus {
  OPEN
  DRAFT
  ANSWERED
  PENDING_CREDENTIALS
}

enum CommerceInboxOrderStatus {
  OPEN
  CANCELLED
  RETURNED
}

model CommerceStore {
  id           String              @id @default(cuid())
  ownerUserId  String              @map("owner_user_id")
  name         String              @db.VarChar(80)
  slug         String              @unique @db.VarChar(48)
  status       CommerceStoreStatus @default(DRAFT)
  currencyCode String              @default("TRY") @db.Char(3) @map("currency_code")
  /// `905` ile başlayan 12 hane. Boşsa vitrin sipariş bağlantısı basılmaz.
  whatsappE164 String?             @map("whatsapp_e164") @db.VarChar(12)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  owner           User                              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  products        CommerceProduct[]
  variants        CommerceVariant[]
  movements       InventoryTransaction[]
  credentials     CommerceMarketplaceCredential[]
  channelListings CommerceChannelListing[]
  webhookReceipts CommerceMarketplaceWebhookReceipt[]
  subscription    CommerceSubscription?
  stockLedgers    StockLedger[]
  salesChannels   SalesChannel[]
  inboxEntries    CommerceInboxEntry[]

  @@index([ownerUserId, createdAt])
  @@map("commerce_stores")
}

model CommerceProduct {
  id            String                @id @default(cuid())
  storeId       String                @map("store_id")
  title         String                @db.VarChar(200)
  description   String                @db.Text
  category      String                @db.VarChar(80)
  attributes    Json                  @default("[]")
  otherNote     String                @default("") @map("other_note") @db.VarChar(500)
  listingMarket String?               @map("listing_market") @db.VarChar(32)
  /// Boş taslak, varyant SKU'sunu kopyalar. Uzak kanal bu kolonu yazmaz.
  sku              String                @default("") @db.VarChar(64)
  /// Baz fiyat, kuruş. 0 fiyat yok demektir.
  basePriceMinor   Int                   @default(0) @map("base_price_minor")
  /// Onaylı merkez stok. Taslak giriş bu sayıyı değiştirmez.
  approvedStockQty Int                   @default(0) @map("approved_stock_qty")
  /// Kritik eşik. 0 uyarıyı kapatır.
  criticalStockQty Int                   @default(0) @map("critical_stock_qty")
  source           CommerceCatalogSource
  status           CommerceProductStatus @default(DRAFT)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  store        CommerceStore        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variants     CommerceVariant[]
  stockLedgers StockLedger[]
  inboxEntries CommerceInboxEntry[]

  @@unique([id, storeId])
  @@index([storeId, status, createdAt])
  @@map("commerce_products")
}

model CommerceVariant {
  id           String                @id @default(cuid())
  storeId      String                @map("store_id")
  productId    String                @map("product_id")
  sku          String                @db.VarChar(64)
  barcode      String?               @db.VarChar(14)
  amountMinor  Int?                  @map("amount_minor")
  onHandQty    Int                   @default(0) @map("on_hand_qty")
  safetyBuffer Int                   @default(0) @map("safety_buffer")
  status       CommerceVariantStatus @default(DRAFT)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  store           CommerceStore                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product         CommerceProduct                    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Restrict)
  movements       InventoryTransaction[]
  channelListings CommerceChannelListing[]
  webhookReceipts CommerceMarketplaceWebhookReceipt[]

  @@unique([storeId, sku])
  @@unique([id, storeId])
  @@index([productId])
  @@map("commerce_variants")
}

model InventoryTransaction {
  id             String                   @id @default(cuid())
  storeId        String                   @map("store_id")
  variantId      String                   @map("variant_id")
  actorUserId    String                   @map("actor_user_id")
  type           InventoryTransactionType
  direction      InventoryDirection
  quantity       Int
  onHandAfter    Int                      @map("on_hand_after")
  note           String                   @default("") @db.VarChar(500)
  idempotencyKey String                   @unique @map("idempotency_key")
  createdAt      DateTime                 @default(now()) @map("created_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)
  actor   User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([storeId, createdAt])
  @@map("inventory_transactions")
}

/// Pazaryeri satıcı kimliği. Düz `supplierId`, `apiKey` ve `apiSecret` kolonu yoktur.
/// Mühür `ccred1:` ve AAD `alan:storeId:KANAL`. Okuma `supplier_hint` ile maskelenir.
model CommerceMarketplaceCredential {
  id            String          @id @default(cuid())
  storeId       String          @map("store_id")
  channel       CommerceChannel
  supplierHint  String          @map("supplier_hint") @db.VarChar(4)
  supplierSeal  String          @map("supplier_seal") @db.Text
  apiKeySeal    String          @map("api_key_seal") @db.Text
  apiSecretSeal String          @map("api_secret_seal") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, channel], map: "commerce_credentials_store_channel_uidx")
  @@index([channel, supplierHint], map: "commerce_credentials_hint_idx")
  @@map("commerce_marketplace_credentials")
}

/// Varyantın Trendyol ilan yansısı. Senkron durumu burada durur; stok deftere yazılır.
model CommerceChannelListing {
  id              String                     @id @default(cuid())
  storeId         String                     @map("store_id")
  variantId       String                     @map("variant_id")
  channel         CommerceChannel
  sku             String                     @db.VarChar(64)
  barcode         String                     @db.VarChar(14)
  remoteBarcode   String                     @map("remote_barcode") @db.VarChar(40)
  remoteProductId String?                    @map("remote_product_id") @db.VarChar(64)
  syncStatus      CommerceListingSyncStatus  @default(PENDING) @map("sync_status")
  lastError       String                     @default("") @map("last_error") @db.VarChar(500)
  lastSyncedAt    DateTime?                  @map("last_synced_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([variantId, channel], map: "commerce_listings_variant_channel_uidx")
  @@unique([storeId, channel, remoteBarcode], map: "commerce_listings_remote_barcode_uidx")
  @@index([storeId, channel, syncStatus], map: "commerce_listings_store_status_idx")
  @@map("commerce_channel_listings")
}

/// Paket + satır mührü. Aynı tane ikinci `SALE` açmaz. `STOCK_SHORT` sessizce kapanmaz.
model CommerceMarketplaceWebhookReceipt {
  id              String                         @id @default(cuid())
  storeId         String                         @map("store_id")
  variantId       String                         @map("variant_id")
  channel         CommerceChannel
  externalOrderId String                         @map("external_order_id") @db.VarChar(64)
  lineId          String                         @map("line_id") @db.VarChar(64)
  status          CommerceWebhookReceiptStatus
  quantity        Int
  note            String                         @default("") @db.VarChar(500)
  createdAt       DateTime                       @default(now()) @map("created_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([storeId, channel, externalOrderId, lineId], map: "commerce_webhook_receipts_line_uidx")
  @@index([storeId, createdAt], map: "commerce_webhook_receipts_store_idx")
  @@map("commerce_marketplace_webhook_receipts")
}

/// Mağaza başı aylık lisans. Tahsilat sahip cüzdanındadır. `user_id` kolonu yoktur.
model CommerceSubscription {
  id                  String                       @id @default(cuid())
  storeId             String                       @unique @map("store_id")
  ownerUserId         String                       @map("owner_user_id")
  status              CommerceSubscriptionStatus   @default(PENDING)
  listPriceMinor      Int                          @map("list_price_minor")
  appliedMerchantOids String[]                     @default([]) @map("applied_merchant_oids")
  expiresAt           DateTime?                    @map("expires_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  owner User          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status], map: "commerce_subscriptions_owner_status_idx")
  @@map("commerce_subscriptions")
}

/// Append-only stok defteri. Taslak satırı onay satırı işaret edene kadar açıktır.
/// `CHANNEL_SALE` miktarı negatiftir (istenen adet). Diğer girişler pozitiftir.
/// İade satırı `0` olabilir: stok değişmeden durum mührü.
model StockLedger {
  id              String           @id @default(cuid())
  storeId         String           @map("store_id")
  productId       String           @map("product_id")
  actorUserId     String           @map("actor_user_id")
  type            StockLedgerType
  channel         SalesChannelKind
  quantity        Int
  stockAfter      Int              @map("stock_after")
  note            String           @default("") @db.VarChar(500)
  idempotencyKey  String           @unique @map("idempotency_key")
  externalOrderId String           @default("") @map("external_order_id") @db.VarChar(64)
  settlesLedgerId String?          @unique @map("settles_ledger_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  store     CommerceStore  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   CommerceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor     User           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  settles   StockLedger?   @relation("StockDraftSettlement", fields: [settlesLedgerId], references: [id], onDelete: Restrict)
  settledBy StockLedger?   @relation("StockDraftSettlement")

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, channel, externalOrderId])
  @@map("stock_ledgers")
}

/// Bağlı satış kanalı. Düz API anahtarı yazılmaz; mühür `ccred1:` ile durur.
model SalesChannel {
  id           String             @id @default(cuid())
  storeId      String             @map("store_id")
  kind         SalesChannelKind
  status       SalesChannelStatus @default(DISCONNECTED)
  apiKeyHint   String             @default("") @map("api_key_hint") @db.VarChar(4)
  apiKeySeal   String             @default("") @map("api_key_seal") @db.Text
  lastError    String             @default("") @map("last_error") @db.VarChar(500)
  lastSyncedAt DateTime?          @map("last_synced_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, kind])
  @@index([storeId, status])
  @@map("sales_channels")
}

/// Sipariş, müşteri sorusu ve uzman görev kısayolu. Sipariş satırı webhook fişinden de okunur.
model CommerceInboxEntry {
  id            String             @id @default(cuid())
  storeId       String             @map("store_id")
  productId     String?            @map("product_id")
  channel       SalesChannelKind
  kind          CommerceInboxKind
  externalRef   String                    @default("") @map("external_ref") @db.VarChar(64)
  customerLabel String                    @default("") @map("customer_label") @db.VarChar(80)
  body          String                    @db.VarChar(2000)
  priority      Int                       @default(0)
  orderStatus   CommerceInboxOrderStatus? @map("order_status")
  replyBody     String                    @default("") @map("reply_body") @db.VarChar(2000)
  replySentAt   DateTime?          @map("reply_sent_at")
  messageStatus CommerceInboxMessageStatus @default(OPEN) @map("message_status")
  /// Uzman görevinin oda durumu. Diğer kutu türlerinde boştur.
  expertStatus  String                     @default("") @map("expert_status") @db.VarChar(16)
  expertNote    String                     @default("") @map("expert_note") @db.VarChar(240)
  /// Webhook fişi. Boş satırlar birbirine çakışmaz.
  idempotencyKey String?           @unique @map("idempotency_key")
  createdAt     DateTime           @default(now()) @map("created_at")

  store   CommerceStore    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product CommerceProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@map("commerce_inbox_entries")
}
