/// Yetkin Commerce — mağaza, Master SKU, append-only stok defteri, pazaryeri kasası.
/// Sahiplik kolonu `owner_user_id` kasıtlıdır: canlı RLS sahiplik sicilinde yoktur.
/// PostgREST `rls_deny_unscoped` (SELECT USING false) alır. Yazma politikası üretilmez.
/// Fiyat `amount_minor`. Para birimi mağazada yalnız TRY.
/// Uzak stok `on_hand_qty` üzerine yazılmaz.
/// Kargo operasyonu `commerce_fulfillment_orders` satırıdır. Etiket metni mağaza gönderici alanlarındadır.
/// Aylık lisans `commerce_subscriptions` satırıdır. Pazaryeri satışı bu tabloya ciro yazmaz.
/// Kâr / komisyon / kargo / kampanya ekonomi katmanı ayrı tablolardadır; `stock_ledgers`'a ciro yazılmaz.

enum CommerceStoreStatus {
  DRAFT
  ACTIVE
}

enum CommerceProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CommerceVariantStatus {
  DRAFT
  ACTIVE
  PASSIVE
}

enum CommerceCatalogSource {
  MANUAL
  MANUAL_CSV
  TEZGAH_PAZARYERI
}

enum InventoryDirection {
  IN
  OUT
}

enum InventoryTransactionType {
  INBOUND
  SALE
  ADJUSTMENT
  RETURN
}

enum CommerceChannel {
  TRENDYOL
  HEPSIBURADA
}

enum CommerceSubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CommerceListingSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CommerceWebhookReceiptStatus {
  APPLIED
  STOCK_SHORT
}

/// Kokpit stok defteri. Taslak onaylanmadan `approved_stock_qty` değişmez.
enum StockLedgerType {
  INBOUND_DRAFT
  INBOUND_APPROVED
  CHANNEL_SALE
  RETURN_RESTOCK
}

enum SalesChannelKind {
  OWN_STORE
  TRENDYOL
  HEPSIBURADA
  AMAZON
  N11
}

enum SalesChannelStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum CommerceInboxKind {
  ORDER
  QUESTION
  EXPERT_TASK
  STOCK_ALERT
  CUSTOMER_QUESTION
  PRODUCT_REVIEW
}

/// Gelen kutu yanıtı. `ANSWERED` yalnız kanalın kabul ettiği gönderimdir.
enum CommerceInboxMessageStatus {
  OPEN
  DRAFT
  ANSWERED
  PENDING_CREDENTIALS
}

enum CommerceInboxOrderStatus {
  OPEN
  CANCELLED
  RETURNED
}

/// Açılış planı. Mevcut mağazalar `GROWTH` kalır; kapı bu kodu okur.
enum CommercePlanCode {
  STARTER
  GROWTH
  SCALE
}

enum CommerceFulfillmentChannel {
  TRENDYOL
  HEPSIBURADA
  OWN_STORE
}

enum CommerceFulfillmentStatus {
  NEW
  PREPARED
  SHIPPED
  DELIVERED
  CANCELED
}

model CommerceStore {
  id           String              @id @default(cuid())
  ownerUserId  String              @map("owner_user_id")
  name         String              @db.VarChar(80)
  slug         String              @unique @db.VarChar(48)
  status       CommerceStoreStatus @default(DRAFT)
  currencyCode String              @default("TRY") @db.Char(3) @map("currency_code")
  /// `905` ile başlayan 12 hane. Boşsa vitrin sipariş bağlantısı basılmaz.
  whatsappE164 String?             @map("whatsapp_e164") @db.VarChar(12)
  /// Kargo etiketindeki logo. Yalnız https adresi. Boşsa unvan rozeti basılır.
  logoUrl      String?             @map("logo_url") @db.VarChar(500)
  senderTitle  String?             @map("sender_title") @db.VarChar(120)
  senderPhone  String?             @map("sender_phone") @db.VarChar(20)
  senderAddress String?            @map("sender_address") @db.VarChar(400)
  /// Plan kapısı. Eski satırlar büyüme paketinde kalır.
  planCode     CommercePlanCode    @default(GROWTH) @map("plan_code")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  owner           User                              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  products        CommerceProduct[]
  variants        CommerceVariant[]
  movements       InventoryTransaction[]
  credentials     CommerceMarketplaceCredential[]
  channelListings CommerceChannelListing[]
  webhookReceipts CommerceMarketplaceWebhookReceipt[]
  subscription      CommerceSubscription?
  trialConsumptions CommerceTrialConsumption[]
  stockLedgers      StockLedger[]
  salesChannels   SalesChannel[]
  inboxEntries    CommerceInboxEntry[]
  unitEconomics     CommerceUnitEconomics[]
  shippingTariffs   CommerceShippingTariff[]
  channelEconomics  CommerceChannelEconomics[]
  campaignSims      CommerceCampaignSimulation[]
  bundleProposals   CommerceBundleProposal[]
  dailyBriefs       CommerceDailyBrief[]
  profitActions     CommerceProfitAction[]
  catalogGapSignals CommerceCatalogGapSignal[]
  productSuggestions CommerceProductSuggestion[]
  demandFeeds       CommerceDemandFeed[]
  channelPriceRules CommerceChannelPriceRule[]
  competitorQuotes  CommerceCompetitorQuote[]
  repriceLogs       CommerceRepriceLog[]
  fulfillmentOrders CommerceFulfillmentOrder[]

  @@index([ownerUserId, createdAt])
  @@map("commerce_stores")
}

/// Sipariş operasyon masası. Stok defterine ciro yazılmaz. Etiket bu satırdan basılır.
model CommerceFulfillmentOrder {
  id                String                     @id @default(cuid())
  storeId           String                     @map("store_id")
  channel           CommerceFulfillmentChannel
  externalOrderNo   String                     @map("external_order_no") @db.VarChar(64)
  customerName      String                     @default("") @map("customer_name") @db.VarChar(120)
  customerPhone     String                     @default("") @map("customer_phone") @db.VarChar(20)
  shippingAddress   String                     @default("") @map("shipping_address") @db.VarChar(500)
  cargoCompany      String                     @default("") @map("cargo_company") @db.VarChar(40)
  cargoTrackingCode String                     @default("") @map("cargo_tracking_code") @db.VarChar(64)
  itemsJson         Json                       @map("items_json")
  totalMinor        Int                        @default(0) @map("total_minor")
  status            CommerceFulfillmentStatus  @default(NEW)
  labelPrintedAt    DateTime?                  @map("label_printed_at")
  shippedAt         DateTime?                  @map("shipped_at")
  slaDeadlineAt     DateTime?                  @map("sla_deadline_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, channel, externalOrderNo])
  @@index([storeId, status, createdAt])
  @@map("commerce_fulfillment_orders")
}

model CommerceProduct {
  id            String                @id @default(cuid())
  storeId       String                @map("store_id")
  title         String                @db.VarChar(200)
  description   String                @db.Text
  category      String                @db.VarChar(80)
  attributes    Json                  @default("[]")
  otherNote     String                @default("") @map("other_note") @db.VarChar(500)
  listingMarket String?               @map("listing_market") @db.VarChar(32)
  /// Boş taslak, varyant SKU'sunu kopyalar. Uzak kanal bu kolonu yazmaz.
  sku              String                @default("") @db.VarChar(64)
  /// Baz fiyat, kuruş. 0 fiyat yok demektir.
  basePriceMinor   Int                   @default(0) @map("base_price_minor")
  /// Onaylı merkez stok. Taslak giriş bu sayıyı değiştirmez.
  approvedStockQty Int                   @default(0) @map("approved_stock_qty")
  /// Kritik eşik. 0 uyarıyı kapatır.
  criticalStockQty Int                   @default(0) @map("critical_stock_qty")
  source           CommerceCatalogSource
  status           CommerceProductStatus @default(DRAFT)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  store        CommerceStore        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variants     CommerceVariant[]
  stockLedgers StockLedger[]
  inboxEntries CommerceInboxEntry[]

  @@unique([id, storeId])
  @@index([storeId, status, createdAt])
  @@map("commerce_products")
}

model CommerceVariant {
  id           String                @id @default(cuid())
  storeId      String                @map("store_id")
  productId    String                @map("product_id")
  sku          String                @db.VarChar(64)
  barcode      String?               @db.VarChar(14)
  amountMinor  Int?                  @map("amount_minor")
  onHandQty    Int                   @default(0) @map("on_hand_qty")
  safetyBuffer Int                   @default(0) @map("safety_buffer")
  status       CommerceVariantStatus @default(DRAFT)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  store           CommerceStore                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product         CommerceProduct                    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Restrict)
  movements       InventoryTransaction[]
  channelListings CommerceChannelListing[]
  webhookReceipts CommerceMarketplaceWebhookReceipt[]
  unitEconomics   CommerceUnitEconomics?
  channelPriceRules CommerceChannelPriceRule[]
  competitorQuotes  CommerceCompetitorQuote[]
  repriceLogs       CommerceRepriceLog[]

  @@unique([storeId, sku])
  @@unique([id, storeId])
  @@index([productId])
  @@map("commerce_variants")
}

model InventoryTransaction {
  id             String                   @id @default(cuid())
  storeId        String                   @map("store_id")
  variantId      String                   @map("variant_id")
  actorUserId    String                   @map("actor_user_id")
  type           InventoryTransactionType
  direction      InventoryDirection
  quantity       Int
  onHandAfter    Int                      @map("on_hand_after")
  note           String                   @default("") @db.VarChar(500)
  idempotencyKey String                   @unique @map("idempotency_key")
  createdAt      DateTime                 @default(now()) @map("created_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)
  actor   User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([storeId, createdAt])
  @@map("inventory_transactions")
}

/// Pazaryeri satıcı kimliği. Düz `supplierId`, `apiKey` ve `apiSecret` kolonu yoktur.
/// Mühür `ccred1:` ve AAD `alan:storeId:KANAL`. Okuma `supplier_hint` ile maskelenir.
model CommerceMarketplaceCredential {
  id            String          @id @default(cuid())
  storeId       String          @map("store_id")
  channel       CommerceChannel
  supplierHint  String          @map("supplier_hint") @db.VarChar(4)
  supplierSeal  String          @map("supplier_seal") @db.Text
  apiKeySeal    String          @map("api_key_seal") @db.Text
  apiSecretSeal String          @map("api_secret_seal") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, channel], map: "commerce_credentials_store_channel_uidx")
  @@index([channel, supplierHint], map: "commerce_credentials_hint_idx")
  @@map("commerce_marketplace_credentials")
}

/// Varyantın Trendyol ilan yansısı. Senkron durumu burada durur; stok deftere yazılır.
model CommerceChannelListing {
  id              String                     @id @default(cuid())
  storeId         String                     @map("store_id")
  variantId       String                     @map("variant_id")
  channel         CommerceChannel
  sku             String                     @db.VarChar(64)
  barcode         String                     @db.VarChar(14)
  remoteBarcode   String                     @map("remote_barcode") @db.VarChar(40)
  remoteProductId String?                    @map("remote_product_id") @db.VarChar(64)
  /// Kanal satış fiyatı, kuruş. Boşsa varyant fiyatı geçerlidir.
  priceMinor      Int?                       @map("price_minor")
  syncStatus      CommerceListingSyncStatus  @default(PENDING) @map("sync_status")
  lastError       String                     @default("") @map("last_error") @db.VarChar(500)
  lastSyncedAt    DateTime?                  @map("last_synced_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([variantId, channel], map: "commerce_listings_variant_channel_uidx")
  @@unique([storeId, channel, remoteBarcode], map: "commerce_listings_remote_barcode_uidx")
  @@index([storeId, channel, syncStatus], map: "commerce_listings_store_status_idx")
  @@map("commerce_channel_listings")
}

/// Paket + satır mührü. Aynı tane ikinci `SALE` açmaz. `STOCK_SHORT` sessizce kapanmaz.
model CommerceMarketplaceWebhookReceipt {
  id              String                         @id @default(cuid())
  storeId         String                         @map("store_id")
  variantId       String                         @map("variant_id")
  channel         CommerceChannel
  externalOrderId String                         @map("external_order_id") @db.VarChar(64)
  lineId          String                         @map("line_id") @db.VarChar(64)
  status          CommerceWebhookReceiptStatus
  quantity        Int
  note            String                         @default("") @db.VarChar(500)
  createdAt       DateTime                       @default(now()) @map("created_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([storeId, channel, externalOrderId, lineId], map: "commerce_webhook_receipts_line_uidx")
  @@index([storeId, createdAt], map: "commerce_webhook_receipts_store_idx")
  @@map("commerce_marketplace_webhook_receipts")
}

/// Mağaza başı aylık lisans. Tahsilat sahip cüzdanındadır. `user_id` kolonu yoktur.
model CommerceSubscription {
  id                  String                       @id @default(cuid())
  storeId             String                       @unique @map("store_id")
  ownerUserId         String                       @map("owner_user_id")
  status              CommerceSubscriptionStatus   @default(PENDING)
  listPriceMinor      Int                          @map("list_price_minor")
  appliedMerchantOids String[]                     @default([]) @map("applied_merchant_oids")
  expiresAt           DateTime?                    @map("expires_at")
  /// Deneme veya ücretli dönemin bittiği an. Yenileme bu alanı tarar.
  trialEndsAt         DateTime?                    @map("trial_ends_at")
  currentPeriodEnd    DateTime?                    @map("current_period_end")
  /// true iken dönem bitene kadar hizmet sürer; yenileme çekimi yapılmaz.
  cancelAtPeriodEnd   Boolean                      @default(false) @map("cancel_at_period_end")
  paytrUtoken         String                       @default("") @map("paytr_utoken") @db.VarChar(128)
  paytrCtoken         String                       @default("") @map("paytr_ctoken") @db.VarChar(128)
  dunningAttempts     Int                          @default(0) @map("dunning_attempts")
  lastDunningAt       DateTime?                    @map("last_dunning_at")
  /// 1 TL kart doğrulama siparişi henüz CLEARED değil.
  trialPending        Boolean                      @default(false) @map("trial_pending")
  trialQuestionsUsed  Int                          @default(0) @map("trial_questions_used")
  trialOptimizationsUsed Int                       @default(0) @map("trial_optimizations_used")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  owner User          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status], map: "commerce_subscriptions_owner_status_idx")
  @@index([status, currentPeriodEnd], map: "commerce_subscriptions_renewal_idx")
  @@map("commerce_subscriptions")
}

/// Satıcı vergi veya TCKN kimliği bir kez deneme tüketir. İkinci mağaza 1 TL deneme açamaz.
/// `sealedAt` boşken satır yalnız ödeme penceresi kilididir (TTL'li); dolu olduğunda
/// hak gerçekten tüketilmiştir (CLEARED) ve bir daha açılmaz.
model CommerceTrialConsumption {
  id          String    @id @default(cuid())
  merchantKey String    @unique @map("merchant_key") @db.VarChar(11)
  storeId     String    @map("store_id")
  consumedAt  DateTime  @default(now()) @map("consumed_at")
  sealedAt    DateTime? @map("sealed_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId], map: "commerce_trial_consumptions_store_idx")
  @@map("commerce_trial_consumptions")
}

/// Append-only stok defteri. Taslak satırı onay satırı işaret edene kadar açıktır.
/// `CHANNEL_SALE` miktarı negatiftir (istenen adet). Diğer girişler pozitiftir.
/// İade satırı `0` olabilir: stok değişmeden durum mührü.
model StockLedger {
  id              String           @id @default(cuid())
  storeId         String           @map("store_id")
  productId       String           @map("product_id")
  actorUserId     String           @map("actor_user_id")
  type            StockLedgerType
  channel         SalesChannelKind
  quantity        Int
  stockAfter      Int              @map("stock_after")
  note            String           @default("") @db.VarChar(500)
  idempotencyKey  String           @unique @map("idempotency_key")
  externalOrderId String           @default("") @map("external_order_id") @db.VarChar(64)
  settlesLedgerId String?          @unique @map("settles_ledger_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  store     CommerceStore  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   CommerceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor     User           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  settles   StockLedger?   @relation("StockDraftSettlement", fields: [settlesLedgerId], references: [id], onDelete: Restrict)
  settledBy StockLedger?   @relation("StockDraftSettlement")

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, channel, externalOrderId])
  @@map("stock_ledgers")
}

/// Bağlı satış kanalı. Düz API anahtarı yazılmaz; mühür `ccred1:` ile durur.
model SalesChannel {
  id           String             @id @default(cuid())
  storeId      String             @map("store_id")
  kind         SalesChannelKind
  status       SalesChannelStatus @default(DISCONNECTED)
  apiKeyHint   String             @default("") @map("api_key_hint") @db.VarChar(4)
  apiKeySeal   String             @default("") @map("api_key_seal") @db.Text
  lastError    String             @default("") @map("last_error") @db.VarChar(500)
  lastSyncedAt DateTime?          @map("last_synced_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, kind])
  @@index([storeId, status])
  @@map("sales_channels")
}

/// Sipariş, müşteri sorusu ve uzman görev kısayolu. Sipariş satırı webhook fişinden de okunur.
model CommerceInboxEntry {
  id            String             @id @default(cuid())
  storeId       String             @map("store_id")
  productId     String?            @map("product_id")
  channel       SalesChannelKind
  kind          CommerceInboxKind
  externalRef   String                    @default("") @map("external_ref") @db.VarChar(64)
  customerLabel String                    @default("") @map("customer_label") @db.VarChar(80)
  body          String                    @db.VarChar(2000)
  priority      Int                       @default(0)
  orderStatus   CommerceInboxOrderStatus? @map("order_status")
  replyBody     String                    @default("") @map("reply_body") @db.VarChar(2000)
  replySentAt   DateTime?          @map("reply_sent_at")
  messageStatus CommerceInboxMessageStatus @default(OPEN) @map("message_status")
  /// Uzman görevinin oda durumu. Diğer kutu türlerinde boştur.
  expertStatus  String                     @default("") @map("expert_status") @db.VarChar(16)
  expertNote    String                     @default("") @map("expert_note") @db.VarChar(240)
  /// Webhook fişi. Boş satırlar birbirine çakışmaz.
  idempotencyKey String?           @unique @map("idempotency_key")
  createdAt     DateTime           @default(now()) @map("created_at")

  store   CommerceStore    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product CommerceProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@map("commerce_inbox_entries")
}

// ---------------------------------------------------------------------------
// Ekonomi katmanı — stok defterinden ayrı. Ciro/kâr stock_ledgers'a yazılmaz.
// ---------------------------------------------------------------------------

enum CommerceCampaignVerdict {
  SAFE
  THIN
  LOSS
}

enum CommerceBundleType {
  TWO
  THREE
}

enum CommerceBundleStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

enum CommerceActionKind {
  REPRICE
  BUNDLE
  RESTOCK
  LOWER_AD
  PAUSE_SKU
}

enum CommerceActionStatus {
  SUGGESTED
  APPLIED
  DISMISSED
}

enum CommerceGapSource {
  OWN_CATALOG
  GRANT_CALL
  TETKIK
  MARKETPLACE_TREND
}

enum CommerceSuggestionStatus {
  NEW
  SEEN
  DISMISSED
  CONVERTED
}

/// Varyant başına maliyet gerçeği. Satıcı girer; kâr motoru hesaplar.
model CommerceUnitEconomics {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  variantId String   @map("variant_id")
  /// COGS (alış + nakliye + gümrük), kuruş.
  costMinor Int      @map("cost_minor")
  /// Hacimsel ağırlık (gram). Desi × 1000.
  desiGrams Int      @map("desi_grams")
  /// KDV baz puan. Varsayılan %20 = 2000.
  vatBps    Int      @default(2000) @map("vat_bps")
  /// `true` ise costMinor alış KDV'sini içerir; kâr motoru girdi KDV'sini mahsup eder.
  costIncludesVat Boolean @default(false) @map("cost_includes_vat")
  updatedAt DateTime @updatedAt @map("updated_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([variantId, storeId])
  @@map("commerce_unit_economics")
}

/// Kargo tarifesi baremi. Paket mimarının kalbi.
model CommerceShippingTariff {
  id            String   @id @default(cuid())
  storeId       String   @map("store_id")
  carrier       String   @db.VarChar(40)
  bandMinGrams  Int      @map("band_min_grams")
  bandMaxGrams  Int      @map("band_max_grams")
  priceMinor    Int      @map("price_minor")
  effectiveFrom DateTime @map("effective_from")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, carrier, bandMinGrams, bandMaxGrams], map: "commerce_shipping_tariff_band_uidx")
  @@index([storeId, carrier, effectiveFrom])
  @@map("commerce_shipping_tariffs")
}

/// Kanal maliyet gerçeği. Satıcı girer; varsayılan sektör ortalaması kodda.
model CommerceChannelEconomics {
  id                  String           @id @default(cuid())
  storeId             String           @map("store_id")
  channel             SalesChannelKind
  commissionBps       Int              @map("commission_bps")
  cargoMinorPerOrder  Int              @map("cargo_minor_per_order")
  returnRateBps       Int              @default(0) @map("return_rate_bps")
  adCostMinorPerOrder Int              @default(0) @map("ad_cost_minor_per_order")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, channel])
  @@map("commerce_channel_economics")
}

/// İndirim simülasyonu kaydı. Sayılar kodda; AI yalnız metin yazar.
model CommerceCampaignSimulation {
  id             String                  @id @default(cuid())
  storeId        String                  @map("store_id")
  variantId      String                  @map("variant_id")
  channel        SalesChannelKind
  listPriceMinor Int                     @map("list_price_minor")
  discountBps    Int                     @map("discount_bps")
  netMinor       Int                     @map("net_minor")
  marginBps      Int                     @map("margin_bps")
  breakEvenBps   Int                     @map("break_even_bps")
  verdict        CommerceCampaignVerdict
  title          String                  @default("") @db.VarChar(120)
  body           String                  @default("") @db.VarChar(500)
  createdAt      DateTime                @default(now()) @map("created_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@map("commerce_campaign_simulations")
}

/// Barem kırıcı paket önerisi. Kabul edilince gerçek CommerceProduct doğar.
model CommerceBundleProposal {
  id                  String               @id @default(cuid())
  storeId             String               @map("store_id")
  type                CommerceBundleType
  memberVariantIds    String[]             @map("member_variant_ids")
  singlePriceMinor    Int                  @map("single_price_minor")
  suggestedPriceMinor Int                  @map("suggested_price_minor")
  netMinor            Int                  @map("net_minor")
  marginBps           Int                  @map("margin_bps")
  cargoSavedMinor     Int                  @map("cargo_saved_minor")
  rationale           String               @db.VarChar(500)
  status              CommerceBundleStatus @default(PROPOSED)
  computedAt          DateTime             @default(now()) @map("computed_at")
  acceptedProductId   String?              @map("accepted_product_id")
  salesCopy           String               @default("") @map("sales_copy") @db.VarChar(1000)

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, status, computedAt])
  @@map("commerce_bundle_proposals")
}

/// Günlük kâr özeti. dayKey Europe/Istanbul YYYY-MM-DD.
model CommerceDailyBrief {
  id           String   @id @default(cuid())
  storeId      String   @map("store_id")
  dayKey       String   @map("day_key") @db.VarChar(10)
  payloadJson  String   @map("payload_json") @db.Text
  netMinor     Int      @map("net_minor")
  lossSkuCount Int      @map("loss_sku_count")
  summaryText  String   @default("") @map("summary_text") @db.VarChar(800)
  createdAt    DateTime @default(now()) @map("created_at")

  store   CommerceStore          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actions CommerceProfitAction[]

  @@unique([storeId, dayKey])
  @@map("commerce_daily_briefs")
}

/// Tek tıkla kâr aksiyonu sicili. Para yazmaz; fiyat/paket önerisi uygular.
model CommerceProfitAction {
  id                String                @id @default(cuid())
  storeId           String                @map("store_id")
  briefId           String                @map("brief_id")
  kind              CommerceActionKind
  variantId         String?               @map("variant_id")
  paramsJson        String                @map("params_json") @db.Text
  expectedGainMinor Int                   @map("expected_gain_minor")
  status            CommerceActionStatus  @default(SUGGESTED)
  appliedAt         DateTime?             @map("applied_at")
  rationale         String                @default("") @db.VarChar(300)

  store CommerceStore      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  brief CommerceDailyBrief @relation(fields: [briefId], references: [id], onDelete: Restrict)

  @@index([storeId, status])
  @@map("commerce_profit_actions")
}

/// Katalog boşluk sinyali. Sayı buradan gelir; LLM sayı üretmez.
model CommerceCatalogGapSignal {
  id             String            @id @default(cuid())
  storeId        String            @map("store_id")
  category       String            @db.VarChar(80)
  priceBandMinor Int               @map("price_band_minor")
  demandIndex    Int               @map("demand_index")
  supplyGap      Int               @map("supply_gap")
  source         CommerceGapSource
  evidenceJson   String            @map("evidence_json") @db.Text
  computedAt     DateTime          @default(now()) @map("computed_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, computedAt])
  @@map("commerce_catalog_gap_signals")
}

/// Dış veya platform içi talep kanıtı. Tarama bu satırı silmez; skor yeniden hesaplanır.
/// İstemci talep endeksi yazamaz. `OWN_CATALOG` bu tabloya alınmaz.
model CommerceDemandFeed {
  id          String            @id @default(cuid())
  storeId     String            @map("store_id")
  source      CommerceGapSource
  category    String            @db.VarChar(80)
  payloadJson String            @map("payload_json") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, source, createdAt])
  @@map("commerce_demand_feeds")
}

/// "Ne satılır?" önerisi. Kanıt zinciri signalIds ile bağlıdır.
model CommerceProductSuggestion {
  id               String                   @id @default(cuid())
  storeId          String                   @map("store_id")
  title            String                   @db.VarChar(200)
  category         String                   @db.VarChar(80)
  targetPriceMinor Int                      @map("target_price_minor")
  rationale        String                   @db.VarChar(500)
  signalIds        String[]                 @map("signal_ids")
  status           CommerceSuggestionStatus @default(NEW)
  createdAt        DateTime                 @default(now()) @map("created_at")

  store CommerceStore @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, status, createdAt])
  @@map("commerce_product_suggestions")
}

enum CommercePriceChannel {
  TRENDYOL
  HEPSIBURADA
  OWN_STORE
  AKAKCE
  CIMRI
}

enum CommerceRepriceStrategy {
  FIXED
  UNDERCUT_STEP
  MATCH_LOWEST
}

enum CommerceRepriceDecision {
  UNDERCUT
  MATCHED
  HOLD_AT_FLOOR
  COMPETITOR_BELOW_FLOOR_ALERT
  REVERT_TO_BASE
}

/// Kanal bazlı baz fiyat, hedef marj ve rekabet stratejisi.
model CommerceChannelPriceRule {
  id                 String                  @id @default(cuid())
  storeId            String                  @map("store_id")
  variantId          String                  @map("variant_id")
  channel            CommercePriceChannel
  basePriceMinor     Int                     @map("base_price_minor")
  minMarginBps       Int                     @default(800) @map("min_margin_bps")
  manualFloorMinor   Int?                    @map("manual_floor_minor")
  strategy           CommerceRepriceStrategy @default(FIXED)
  stepMinor          Int                     @default(100) @map("step_minor")
  autoApply          Boolean                 @default(false) @map("auto_apply")
  activePriceMinor   Int                     @map("active_price_minor")
  computedFloorMinor Int?                    @map("computed_floor_minor")
  lastRepricedAt     DateTime?               @map("last_repriced_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([storeId, variantId, channel])
  @@index([storeId, autoApply])
  @@map("commerce_channel_price_rules")
}

/// Satıcının veya entegrasyonun beslediği rakip fiyatı. Dış site kazıması yazılmaz.
model CommerceCompetitorQuote {
  id                   String               @id @default(cuid())
  storeId              String               @map("store_id")
  variantId            String               @map("variant_id")
  channel              CommercePriceChannel
  competitorName       String               @map("competitor_name") @db.VarChar(120)
  competitorUrl        String               @default("") @map("competitor_url") @db.VarChar(500)
  competitorPriceMinor Int                  @map("competitor_price_minor")
  observedAt           DateTime             @map("observed_at")
  createdAt            DateTime             @default(now()) @map("created_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([storeId, variantId, channel, observedAt])
  @@map("commerce_competitor_quotes")
}

/// Rekabet kararı günlüğü. Fiyat tabanın altına yazılmaz.
model CommerceRepriceLog {
  id                   String                  @id @default(cuid())
  storeId              String                  @map("store_id")
  variantId            String                  @map("variant_id")
  channel              CommercePriceChannel
  previousPriceMinor   Int                     @map("previous_price_minor")
  competitorPriceMinor Int?                    @map("competitor_price_minor")
  floorPriceMinor      Int                     @map("floor_price_minor")
  newPriceMinor        Int                     @map("new_price_minor")
  decision             CommerceRepriceDecision
  createdAt            DateTime                @default(now()) @map("created_at")

  store   CommerceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variant CommerceVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@map("commerce_reprice_logs")
}
