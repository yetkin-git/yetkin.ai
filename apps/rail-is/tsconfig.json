{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "@yetkin/junior-graphic": ["../../packages/junior-graphic/src/index.ts"],
      "@yetkin/junior-graphic/*": ["../../packages/junior-graphic/src/*"],
      "@yetkin/kernel": ["../../packages/kernel/src/index.ts"],
      "@yetkin/kernel/*": ["../../packages/kernel/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/kernel/src/**/*.ts",
    "../../lib/academy/punchcard-from-sealed-json.ts",
    "../../lib/academy/lesson-audio-timings/**/*.json",
    "../../lib/academy/lesson-cues/**/*.json"
  ]
}
