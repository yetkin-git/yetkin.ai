{
  "name": "yetkin-rail",
  "version": "0.1.0",
  "private": true,
  "description": "Yetkin Rail — mühürlü emek işletim sistemi",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run verify:prebuild && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ops:migrate": "tsx scripts/ops-migrate.ts",
    "ops:init": "npm run ops:migrate",
    "ops:storage-cors": "tsx scripts/ops-storage-cors-check.ts",
    "ops:runtime-readiness": "tsx scripts/ops-runtime-readiness.ts",
    "ops:t3-academy-loop": "tsx scripts/ops-t3-academy-loop.ts",
    "ops:t4-freelancer-loop": "tsx scripts/ops-t4-freelancer-loop.ts",
    "verify:staging-t4-loop": "tsx scripts/verify-staging-t4-loop.ts",
    "verify:no-secrets": "tsx scripts/verify-no-secrets.ts",
    "verify:amount-minor": "tsx scripts/verify-amount-minor.ts",
    "verify:ai-gateway": "tsx scripts/verify-ai-gateway.ts",
    "verify:rls-status": "tsx scripts/verify-rls-status.ts",
    "verify:api-auth": "tsx scripts/verify-api-auth.ts",
    "verify:atomic-seals": "tsx scripts/verify-atomic-seals.ts",
    "verify:boundaries": "tsx scripts/verify-boundaries.ts",
    "verify:sen-axis": "tsx scripts/verify-sen-axis.ts",
    "test:surface": "vitest run surface.test.ts constitution-surfaces.test.ts",
    "verify:prebuild": "npm run verify:no-secrets && npm run verify:amount-minor && npm run verify:ai-gateway && npm run verify:rls-status && npm run verify:api-auth && npm run verify:boundaries && npm run verify:sen-axis && npm run verify:atomic-seals && npm run test:surface && npm run typecheck"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "inngest": "^4.11.0",
    "jose": "^6.2.9",
    "next": "^16.2.9",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  }
}
